# Unreal Engine generated files (Build may contain source-controlled resources)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Offline generated preparation report
/Build/Preparation/
/Build/Packages/
/Build/Releases/
/Build/PackagingLogs/
/Platformer_2D_Game/Build/Windows/FileOpenOrder/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets and OS files
.env
.env.*
!.env.example
Thumbs.db
.DS_Store

# Local editor recovery copies (generated by the asset scripts)
*.blend[0-9]*
/Assets/Models/**/Before*/
/Assets/Models/**/Before*.blend
/Assets/Models/**/Untitled.blend
/Platformer_2D_Game/Content/**/*_Before*.uasset
/Platformer_2D_Game/Content/**/*_Before*.umap

# Local assistant configuration and credentials
/.codex/
/.agents/
/.aws/
